{
  "$schema": "https://docs.openclaw.ai/schema/config.json",
  "comment": "OpenClaw configuration template - auto-generated by Claude Code++ install.sh",

  "agent": {
    "model": "anthropic/claude-sonnet-4-5",
    "fastModel": "anthropic/claude-haiku-4-5",
    "maxTokens": 4096,
    "temperature": 0.7
  },

  "gateway": {
    "port": 18789,
    "bind": "loopback",
    "mode": "local"
  },

  "plugins": {
    "memory-mcp-bridge": {
      "enabled": true,
      "mcpCommand": "~/.claude-code-pp/bin/memory-mcp",
      "mcpArgs": [],
      "autoRecall": true,
      "autoCapture": true,
      "recallLimit": 5,
      "recallMinScore": 0.3
    }
  },

  "channels": {
    "comment": "Configure channels via 'openclaw config set' or add tokens below"
  },

  "security": {
    "allowedDomains": [],
    "blockedDomains": [],
    "maxMessageLength": 10000,
    "rateLimitPerMinute": 20
  },

  "logging": {
    "level": "info",
    "conversations": true,
    "toolCalls": true
  }
}
